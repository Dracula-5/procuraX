# Copy to .env for local overrides. All settings use the PROCURAX_ prefix (app/core/config.py).
PROCURAX_ENV=dev

# Runtime role: NOT a superuser and NOT the table owner, so Row-Level Security applies.
PROCURAX_DATABASE_URL=postgresql+asyncpg://procurax_app:procurax_app_dev@127.0.0.1:55433/procurax
# Owner role: migrations and seed scripts only.
PROCURAX_DATABASE_ADMIN_URL=postgresql+asyncpg://procurax:procurax_dev@127.0.0.1:55433/procurax

# Required in prod (>= 32 chars). Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave commented in dev to use the built-in development key (rejected when PROCURAX_ENV=prod).
# PROCURAX_JWT_SECRET=
PROCURAX_ACCESS_TOKEN_TTL_MINUTES=60

PROCURAX_CORS_ORIGINS=["http://localhost:5173"]
PROCURAX_PUBLIC_APP_URL=http://localhost:5173
PROCURAX_DEMO_MODE=true

# Approval SLA escalation inside the API process (seconds; 0 = off, use scripts/run_sla_escalations.py).
PROCURAX_SLA_ESCALATION_INTERVAL_SECONDS=0
# Failed sign-in throttle per client address + e-mail (single API process).
PROCURAX_LOGIN_MAX_FAILURES=5
PROCURAX_LOGIN_LOCKOUT_SECONDS=900

# Notifications (transactional outbox). In-app notifications always work; external channels are off
# until enabled. Run the worker with `python -m app.worker`, or set an interval to run it in the API.
PROCURAX_NOTIFICATION_WORKER_INTERVAL_SECONDS=0
PROCURAX_NOTIFICATION_MAX_ATTEMPTS=6
# E-mail through Mailpit from docker-compose (web UI http://localhost:8025).
PROCURAX_EMAIL_ENABLED=false
PROCURAX_SMTP_HOST=127.0.0.1
PROCURAX_SMTP_PORT=1025
PROCURAX_EMAIL_FROM=ProcuraX <no-reply@procurax.local>
# Slack / Teams incoming webhooks configured per tenant by its admin.
PROCURAX_WEBHOOKS_ENABLED=false
# Encrypts tenant webhook URLs at rest (32+ random characters; required in prod when webhooks are on).
# PROCURAX_DATA_ENCRYPTION_KEY=

# Invoice files. "local" writes under PROCURAX_STORAGE_LOCAL_DIR (development only; production
# refuses uploads on local disk). "s3": RustFS from docker-compose locally, AWS S3 or Cloudflare R2.
PROCURAX_STORAGE_BACKEND=local
PROCURAX_STORAGE_LOCAL_DIR=var/documents
# PROCURAX_S3_ENDPOINT_URL=http://127.0.0.1:9000
# PROCURAX_S3_BUCKET=procurax-documents
# PROCURAX_S3_ACCESS_KEY_ID=procurax
# PROCURAX_S3_SECRET_ACCESS_KEY=procurax-dev-secret
# Retain invoices 7 years (Japanese corporate tax law); recorded per file, nothing is auto-deleted.
PROCURAX_DOCUMENT_RETENTION_YEARS=7
# Virus scan with ClamAV (docker compose --profile scan). Off: files are marked not_scanned and
# block payment unless PROCURAX_ALLOW_UNSCANNED_DOCUMENTS=true.
PROCURAX_CLAMAV_ENABLED=false
PROCURAX_ALLOW_UNSCANNED_DOCUMENTS=false

# Optional local OCR binaries; unset values resolve from PATH. PDF OCR also needs pdftoppm.
PROCURAX_TESSERACT_PATH=
PROCURAX_PDFTOPPM_PATH=
# Directory holding eng.traineddata etc. when Tesseract is not installed system-wide.
PROCURAX_TESSDATA_PATH=
PROCURAX_OCR_LANGUAGES=eng
