# Copy to .env for local overrides. All settings use the PROCURAX_ prefix (app/core/config.py).
PROCURAX_ENV=dev

# Runtime role: NOT a superuser and NOT the table owner, so Row-Level Security applies.
PROCURAX_DATABASE_URL=postgresql+asyncpg://procurax_app:procurax_app_dev@127.0.0.1:55433/procurax
# Owner role: migrations and seed scripts only.
PROCURAX_DATABASE_ADMIN_URL=postgresql+asyncpg://procurax:procurax_dev@127.0.0.1:55433/procurax

# Required in prod (>= 32 chars). Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave commented in dev to use the built-in development key (rejected when PROCURAX_ENV=prod).
# PROCURAX_JWT_SECRET=
PROCURAX_ACCESS_TOKEN_TTL_MINUTES=60

PROCURAX_CORS_ORIGINS=["http://localhost:5173"]
PROCURAX_PUBLIC_APP_URL=http://localhost:5173
PROCURAX_DEMO_MODE=true

# Approval SLA escalation inside the API process (seconds; 0 = off, use scripts/run_sla_escalations.py).
PROCURAX_SLA_ESCALATION_INTERVAL_SECONDS=0
# Failed sign-in throttle per client address + e-mail (single API process).
PROCURAX_LOGIN_MAX_FAILURES=5
PROCURAX_LOGIN_LOCKOUT_SECONDS=900

# Optional local OCR binaries; unset values resolve from PATH. PDF OCR also needs pdftoppm.
PROCURAX_TESSERACT_PATH=
PROCURAX_PDFTOPPM_PATH=
# Directory holding eng.traineddata etc. when Tesseract is not installed system-wide.
PROCURAX_TESSDATA_PATH=
PROCURAX_OCR_LANGUAGES=eng
